    Q3 = valid_data.quantile(0.75)
    IQR = Q3 - Q1
    lower_bound = Q1 - 1.5 * IQR
    upper_bound = Q3 + 1.5 * IQR
    
    outliers = []
    for idx, row in df.iterrows():
        value = row[year_col]
        if pd.isna(value):
            continue
        if value < lower_bound or value > upper_bound:
            outliers.append((row['breed'], year_col))
    return outliers

# Find outliers for each year
