IQR = Q3 - Q1
lower_bound = Q1 - 1.5 * IQR
upper_bound = Q3 + 1.5 * IQR

outliers = []
for i, (density, gdp) in enumerate(zip(pop_density, gdp_per_capita)):
    if density < lower_bound or density > upper_bound:
