import pandas as pd

df = pd.read_csv('table.csv')

# Convert relevant columns to numeric
numeric_cols = ['elevation (m)', 'prominence (m)', 'col (m)']
df_numeric = df[numeric_cols].apply(pd.to_numeric, errors='coerce')

# Function to detect outliers using IQR
def detect_outliers_iqr(series):
    Q1 = series.quantile(0.25)
    Q3 = series.quantile(0.75)
    IQR = Q3 - Q1
    lower_bound = Q1 - 1.5 * IQR
    upper_bound = Q3 + 1.5 * IQR
    return (series < lower_bound) | (series > upper_bound)

# Apply outlier detection to each column
outlier_rows = []
for idx, row in df.iterrows():
    row_outliers = False
    for col in numeric_cols:
        if detect_outliers_iqr(df_numeric[col]).iloc[idx]:
            row_outliers = True
            break
    if row_outliers:
        outlier_rows.append(idx)

# Extract the corresponding data points (rows)
outlier_data = df.iloc[outlier_rows]
print(outlier_data.to_string(index=False))
