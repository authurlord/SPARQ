costs = df.iloc[0].str.extract(r'(\d+)', expand=False).astype(float)

# Filter rows where energy output >= 2000 kwh/kwp/y (from column "2000 kwh / kwp y" onwards)
# Columns from index 8 onwards (since "1000 kwh / kwp y" is at index 8, "2000 kwh / kwp y" is at index 9)
energy_columns = df.columns[8:]  # From '1000 kwh / kwp y' to '4600 kwh / kwp y'
filtered_rows = []

for idx, row in df.iterrows():
    # Check if any of the energy columns (from 2000 onwards) is >= 2000
    energy_values = row[energy_columns]
    if any(val >= 2000 for val in energy_values):
        # Check if cost <= 1400
        cost_val = costs.iloc[idx]
