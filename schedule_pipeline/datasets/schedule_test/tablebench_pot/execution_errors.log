import pandas as pd
import matplotlib.pyplot as plt

# Load the data
df = pd.read_csv('table.csv')

# Parse Introduced and Withdrawn columns
def parse_year(year_str):
    if isinstance(year_str, str):
        # Handle cases like '25→4', '37→35→6'
        parts = year_str.split('→')
        if len(parts) == 1:
            return int(parts[0])
        else:
            # Take first part as introduced, last as withdrawn
            introduced = int(parts[0])
            withdrawn = int(parts[-1])
            return introduced, withdrawn
    return None

# Apply parsing
df['Introduced'] = df['Introduced'].apply(parse_year)
df['Withdrawn'] = df['Withdrawn'].apply(lambda x: int(x) if isinstance(x, str) and x.isdigit() else x)

# Create lifespan
df['lifespan'] = df['Withdrawn'] - df['Introduced']

# Prepare data for plotting
data = df[['Name', 'lifespan']].copy()
data = data.sort_values(by='lifespan', ascending=False)

# Plot horizontal bar chart
plt.figure(figsize=(10, 6))
plt.barh(data['Name'], data['lifespan'], color='skyblue')
plt.xlabel('Lifespan (years)')
plt.ylabel('Locomotive Name')
plt.title('Lifespan of Each Locomotive')
plt.gca().invert_yaxis()  # To show longest lifespan at top
plt.tight_layout()
plt.show()
