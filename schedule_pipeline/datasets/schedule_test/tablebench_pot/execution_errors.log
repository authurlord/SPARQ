df['% 2001'] = pd.to_numeric(df['% 2001'], errors='coerce')
df['seats 2006'] = pd.to_numeric(df['seats 2006'], errors='coerce')
df['seats 2001'] = pd.to_numeric(df['seats 2001'], errors='coerce')

# Exclude total row and voter turnout row for party analysis
parties = df[df['parties and voter communities'].ne('total')].copy()

# Calculate changes in % and seats
parties['% change 2006-2001'] = parties['% 2006'] - parties['% 2001']
parties['seats change 2006-2001'] = parties['seats 2006'] - parties['seats 2001']

# Display summary of changes
print("Party Performance Analysis (2006 vs 2001):")
print(parties[['parties and voter communities', '% 2006', '% 2001', '% change 2006-2001', 'seats 2006', 'seats 2001', 'seats change 2006-2001']].round(2))

# Voter turnout observation
turnout_2001 = df[df['parties and voter communities'] == 'voter turnout in %']['% 2001'].values[0]
turnout_2006 = df[df['parties and voter communities'] == 'voter turnout in %']['% 2006'].values[0]
print(f"Voter turnout: {turnout_2001}% in 2001, {turnout_2006}% in 2006 (a decrease of {abs(turnout_2001 - turnout_2006)} percentage points).")

