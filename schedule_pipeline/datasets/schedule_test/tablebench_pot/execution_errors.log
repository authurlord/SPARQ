pop_80_plus = total_row['POPULATION (by age group in 2002)_9']  # 80 +

# Young dependents (0-9)
young = pop_0_9

# Elderly dependents (60+)
elderly = pop_60_69 + pop_70_79 + pop_80_plus

# Working-age population (10-59)
working_age = pop_10_19 + pop_20_29 + pop_30_39 + pop_40_49 + pop_50_59

# Dependency ratio
dependency_ratio = (young + elderly) / working_age

