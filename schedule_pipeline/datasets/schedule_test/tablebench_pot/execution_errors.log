df['area (km 2)'] = pd.to_numeric(df['area (km 2)'], errors='coerce')
df['population'] = pd.to_numeric(df['population'], errors='coerce')

# Remove rows with NaN due to conversion errors
df = df.dropna(subset=['area (km 2)', 'population'])

# Calculate mean and std for area and population
mean_area = df['area (km 2)'].mean()
std_area = df['area (km 2)'].std()
mean_pop = df['population'].mean()
std_pop = df['population'].std()

# Define outlier thresholds (2 standard deviations from mean)
area_outliers = np.abs(df['area (km 2)'] - mean_area) > 2 * std_area
pop_outliers = np.abs(df['population'] - mean_pop) > 2 * std_pop

# Find locations that are outliers in either area or population
outlier_locations = []
for idx, row in df.iterrows():
    if area_outliers.iloc[idx] or pop_outliers.iloc[idx]:
        outlier_locations.append(row['place'])

# Remove duplicates and sort
outlier_locations = list(set(outlier_locations))

print(f"Final Answer: {', '.join(outlier_locations)}")
