Code:
import pandas as pd

df = pd.read_csv('table.csv')

# Clean up column names and data
df.columns = ['Round', 'Klaus_Deputies', 'Klaus_Senators', 'Moserova_Deputies', 'Moserova_Senators', 'Zeman_Deputies', 'Zeman_Senators']

# Convert vote columns to numeric, treating '-' as NaN
for col in ['Zeman_Deputies', 'Zeman_Senators']:
    df[col] = pd.to_numeric(df[col], errors='coerce')

# Iterate through the dataframe in pairs (vote row, total row)
rounds = df['Round'].unique()
rounds = [r for r in rounds if r != 'Round']

first_majority_round = None

for r in rounds:
    # Get vote row (first occurrence of the round)
    vote_row = df[(df['Round'] == r) & (df['Klaus_Deputies'] != r)].iloc[0]
    # Get total row (second occurrence of the round)
    total_row = df[(df['Round'] == r) & (df['Klaus_Deputies'] == r)].iloc[0]
    
    zeman_deputies = vote_row['Zeman_Deputies']
    zeman_senators = vote_row['Zeman_Senators']
    
    # Skip if Zeman data is missing
    if pd.isna(zeman_deputies) or pd.isna(zeman_senators):
        continue
        
    total_deputies = int(total_row['Klaus_Deputies'])
    total_senators = int(total_row['Klaus_Senators'])
    
    total_votes = total_deputies + total_senators
    zeman_votes = zeman_deputies + zeman_senators
    
    if zeman_votes > total_votes / 2:
        first_majority_round = r
        break

if first_majority_round:
    print(f"Final Answer: {first_majority_round}")
else:
    print("Final Answer: None")
