    "import re\n",
    "from tqdm.notebook import tqdm\n",
    "from utils.evaluator import Evaluator\n",
    "\n",
    "def niat_match_func_robust(pred, gold):\n",
    "    \"\"\"\n",
    "    独立评估函数：对比预测答案与标准答案 (NIAT Robust Version)。\n",
    "    \n",
    "    Args:\n",
    "        pred (str): 预测答案字符串 (e.g. '2. Final Answer: The answer is: \"IFK Göteborg\"')\n",
    "        gold (str): 标准答案字符串 (e.g. 'IFK Göteborg')\n",
    "    \n",
    "    Returns:\n",
    "        bool: True 表示匹配正确\n",
    "    \"\"\"\n",
    "    # 1. Parsing: 解析 \"The answer is:\" 之后的真实答案\n",
    "    if isinstance(pred, str):\n",
    "        # 使用 Ignore Case 匹配，更加鲁棒\n",
    "        match = re.search(r'The answer is:\\s*(.+)', pred, re.IGNORECASE)\n",
    "        if match:\n",
    "            pred = match.group(1)\n",
    "            \n",
    "    # 2. Evaluation: 复用 Evaluator 中的 WikiTQ 逻辑 (eval_ex_match)\n",
    "    # 传入 allow_semantic=True 以支持归一化和语义匹配\n",
    "    # 传入 question=\"\" 以绕过 Evaluator 中的 assertion，同时跳过仅针对 boolean/choice 的特殊逻辑\n",
    "    return Evaluator().eval_ex_match(pred, gold, allow_semantic=True, question=\"\")\n",
    "\n",
    "def calculate_niat_accuracy(preds, golds):\n",
    "    \"\"\"\n",
    "    计算准确率 (Accuracy)。\n",
    "    \n",
    "    Args:\n",
    "        preds (List[str]): 预测答案列表\n",
    "        golds (List[str]): 标准答案列表\n",
    "    \n",
    "    Returns:\n",
    "        float: Accuracy (0.0 ~ 1.0)\n",
    "    \"\"\"\n",
    "    if len(preds) != len(golds):\n",
    "        print(f\"Warning: preds count ({len(preds)}) != golds count ({len(golds)})\")\n",
    "        \n",
    "    correct_count = 0\n",
    "    total_count = 0\n",
    "    \n",
    "    for p, g in tqdm(zip(preds, golds)):\n",
    "        try:\n",
    "            if niat_match_func_robust(p, g):\n",
    "                correct_count += 1\n",
    "        except Exception as e:\n",
    "            print(f\"Error evaluating pair: p='{p}', g='{g}'. Error: {e}\")\n",
    "        finally:\n",
    "            total_count += 1\n",
    "            \n",
    "    if total_count == 0:\n",
    "        return 0.0\n",
    "        \n",
    "    return correct_count / total_count"
   ]
  },
