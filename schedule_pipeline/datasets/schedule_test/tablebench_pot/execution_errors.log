# Find the minimum difference and the corresponding pair of universities
min_diff = min(diffs)
# Find the indices where this minimum difference occurs
indices = [i for i, d in enumerate(diffs) if d == min_diff]
# Get the university names at these indices
smaller_enrollment = enrollments.iloc[indices[0]]
larger_enrollment = enrollments.iloc[indices[0] + 1]
# Get the university names
university1 = df.loc[df['enrollment'] == smaller_enrollment, 'location'].values[0]
