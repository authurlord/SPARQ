import pandas as pd
import matplotlib.pyplot as plt

# Load the data
df = pd.read_csv('table.csv')

# Clean land area column - extract numeric value before 'sq mi'
def extract_land_area(area_str):
    # Remove ' sq mi (km2)' or ' km2' suffix
    if ' sq mi (km2)' in area_str:
        return float(area_str.replace(' sq mi (km2)', '').strip())
    elif ' km2' in area_str:
        return float(area_str.replace(' km2', '').strip())
    else:
        return float(area_str.strip())

# Apply the extraction function
df['Land area'] = df['Land area'].apply(extract_land_area)

# Convert population to numeric (remove commas)
df['Population (2012 est.)'] = df['Population (2012 est.)'].str.replace(',', '').astype(int)

# Calculate population density
df['density'] = df['Population (2012 est.)'] / df['Land area']

# Sort by density in descending order and take top 10
top_10 = df.sort_values('density', ascending=False).head(10)

# Create bar chart
plt.figure(figsize=(12, 8))
plt.bar(top_10['Name'], top_10['density'], color='skyblue')
plt.title('Top 10 Regions by Population Density')
plt.xlabel('Region')
