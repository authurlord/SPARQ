import pandas as pd
import numpy as np

df = pd.read_csv('table.csv')

# Extract the 'Model' and 'Power output (hp)' columns
models = df['Model']
power_output = df['Power output (hp)']

# Function to convert power output to numeric
def parse_power(output):
    if output == '-' or pd.isna(output):
        return 0
    if '/' in output:
        parts = output.split('/')
        return max(int(p) for p in parts)
    return int(output)

# Apply parsing and create a new series
parsed_power = power_output.apply(parse_power)

# Combine model and parsed power, then sort by power in descending order
ranked = list(zip(models, parsed_power))
ranked.sort(key=lambda x: x[1], reverse=True)

# Extract just the model names in ranked order
ranked_models = [model for model, _ in ranked]

