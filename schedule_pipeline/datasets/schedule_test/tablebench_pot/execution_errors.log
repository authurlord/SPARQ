# Remove rows where any comprehension score is 'n / a' to avoid NaN issues
df_clean = df.dropna(subset=['comprehension of danish', 'comprehension of swedish', 'comprehension of norwegian'])

# Convert comprehension columns to float for analysis
df_clean['comprehension of danish'] = pd.to_numeric(df_clean['comprehension of danish'], errors='coerce')
df_clean['comprehension of swedish'] = pd.to_numeric(df_clean['comprehension of swedish'], errors='coerce')
df_clean['comprehension of norwegian'] = pd.to_numeric(df_clean['comprehension of norwegian'], errors='coerce')

# Calculate average comprehension per city
df_clean['average'] = df_clean[['comprehension of danish', 'comprehension of swedish', 'comprehension of norwegian']].mean(axis=1)

# Find the highest and lowest average comprehension
max_avg = df_clean['average'].max()
min_avg = df_clean['average'].min()

# Identify top and bottom cities by average comprehension
top_city = df_clean.loc[df_clean['average'].idxmax(), 'city']
bottom_city = df_clean.loc[df_clean['average'].idxmin(), 'city']

print(f"Main features: The table shows comprehension levels of Danish, Swedish, and Norwegian in major Scandinavian cities. Data is missing for some cities in specific languages. Average comprehension is calculated per city.")
print(f"Insights: Highest average comprehension is in {top_city} ({max_avg:.2f}), lowest in {bottom_city} ({min_avg:.2f}). Cities in Norway generally show strong comprehension in all languages, while Swedish cities like Malmö excel in local language skills.")
