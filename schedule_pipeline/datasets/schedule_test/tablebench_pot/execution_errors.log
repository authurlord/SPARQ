# Define episode types
episode_types = {
    'auditions': ['auditions 1', 'auditions 2', 'auditions 3', 'auditions 4', 'auditions 5', 'auditions 6', 'auditions 7'],
    'semi-final': ['semi - final 1', 'semi - final 1 results', 'semi - final 2', 'semi - final 2 results', 'semi - final 3', 'semi - final 3 results', 'semi - final 4', 'semi - final 4 results', 'semi - final 5', 'semi - final 5 results'],
    'final': ['live final']
}

