import pandas as pd
import matplotlib.pyplot as plt
import re

df = pd.read_csv('table.csv')

# Filter data for year 1948
row_1948 = df[df['Year'] == '1948']

# Ethnic groups columns (excluding 'Year' and 'Total')
ethnic_columns = ['Serbs', 'Hungarians', 'Germans', 'Romanians', 'Slovaks']

# Extract numeric values from the formatted strings
populations = []
labels = []
for col in ethnic_columns:
    value = row_1948[col].iloc[0]
    if pd.notna(value):
        # Extract number before the space or parenthesis
        num = int(re.search(r'\d+', value).group())
        populations.append(num)
        labels.append(col)

# Plot pie chart
plt.figure(figsize=(8, 8))
plt.pie(populations, labels=labels, autopct='%1.1f%%', startangle=140)
plt.title('Racial Composition in 1948')
plt.axis('equal')
plt.show()
