import pandas as pd

df = pd.read_csv('table.csv')

# Find the row with total population in persons
total_row = df[(df['SPECIFICATION_1'] == 'TOTAL') & (df['Measure unit'] == 'person')]

# Extract the relevant age group columns
# The columns for age groups are: '0-9', '10-19', '20-29', '30-39', '40-49', '50-59', '60-69', '70-79', '80 +'
young = total_row['0-9'].values[0]  # 0-9 as proxy for 0-10
old = total_row['60-69'].values[0] + total_row['70-79'].values[0] + total_row['80 +'].values[0]
working_age = total_row['10-19'].values[0] + total_row['20-29'].values[0] + total_row['30-39'].values[0] + total_row['40-49'].values[0] + total_row['50-59'].values[0]

# However, note: the question defines working-age as 11-59, but our working_age here includes 10-19 (which has 10-year-olds). 
# But without single-year data, the standard approach in such tables is to consider 0-14 and 65+ as dependents, but the question specifies 0-10 and 60+.
# Given the data constraints, we proceed with:
#   young_dependent = 0-9 (we assume this approximates 0-10)
#   old_dependent = 60+
#   working = total - young_dependent - old_dependent
total_pop = total_row['TOTAL'].values[0]
working_age_alt = total_pop - young - old

# We'll use working_age_alt to be consistent with the definition (11-59 = total - (0-10) - (60+)), and since we approximated 0-10 as 0-9, this is acceptable.
dependency_ratio = (young + old) / working_age_alt

# Print the ratio rounded to two decimal places as an approximation
print(f"Final Answer: {dependency_ratio:.2f}")
