import pandas as pd
import numpy as np

df = pd.read_csv('table.csv')

# Filter out the total row and rows with '—' in Owned or Leased
df_filtered = df[df['Row Header'] != 'Total mainline']

# Function to compute average seats from range
def avg_seats_from_range(seats_str):
    if pd.isna(seats_str) or seats_str == '—':
        return 0
    try:
        # Split by dash and convert to numbers
        parts = seats_str.strip().split('-')
        if len(parts) == 2:
            return (int(parts[0]) + int(parts[1])) / 2
        else:
            return int(parts[0])
    except:
        return 0

# Calculate total seats and total aircraft per type
seat_density = []

for _, row in df_filtered.iterrows():
    aircraft_type = row['Row Header']
    total_seats = avg_seats_from_range(row['Seats in Standard Configuration'])
    owned = row['Owned']
    leased = row['Leased']
    
    # Total aircraft
    total_aircraft = owned + leased if pd.notna(owned) and pd.notna(leased) else 0
    
    # Skip if no aircraft
    if total_aircraft == 0:
        continue
        
    # Total seats: use average per aircraft times number of aircraft
    # But note: "Seats in Standard Configuration" is per aircraft, so total seats = total_aircraft * average_seats_per_aircraft
    # However, the data shows "Seats in Standard Configuration" as a range — this is per aircraft.
    # So total seats = total_aircraft * avg_seats_per_aircraft
    # But the question asks for "average seat density" = total seats / total aircraft = avg_seats_per_aircraft
    # So average seat density is just the average of the range (per aircraft)
    
    seat_density.append({
        'aircraft': aircraft_type,
        'density': total_seats
    })

# Find the aircraft with highest average seat density
result = max(seat_density, key=lambda x: x['density'])
Final Answer: {result['aircraft']}
