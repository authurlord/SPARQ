pop_20_29 = total_row['POPULATION (by age group in 2002)_3']    # 20-29
pop_30_39 = total_row['POPULATION (by age group in 2002)_4']    # 30-39
pop_40_49 = total_row['POPULATION (by age group in 2002)_5']    # 40-49
