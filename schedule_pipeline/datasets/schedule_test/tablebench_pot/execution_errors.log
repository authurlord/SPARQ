import pandas as pd

df = pd.read_csv('table.csv')

# Convert the data to a DataFrame
# Calculate percentage increase for domestic and foreign total steel tonnage
def calculate_percentage_increase(row):
    domestic = row['domestic s ton']
    foreign_total = row['foreign total s ton']
    prev_row = df[df['year'] < row['year']].iloc[-1] if df[df['year'] < row['year']].shape[0] > 0 else None
    if prev_row is None:
        return 0, 0  # No previous year to compare
    prev_domestic = prev_row['domestic s ton']
    prev_foreign = prev_row['foreign total s ton']
    dom_inc = ((domestic - prev_domestic) / prev_domestic) * 100 if prev_domestic != 0 else 0
    fore_inc = ((foreign_total - prev_foreign) / prev_foreign) * 100 if prev_foreign != 0 else 0
    return dom_inc, fore_inc

# Apply the function to each row (except the first)
results = []
for i in range(1, len(df)):
    dom_inc, fore_inc = calculate_percentage_increase(df.iloc[i])
    if dom_inc > fore_inc:
        results.append(df.iloc[i]['year'])

print(f"Final Answer: {results[0] if results else 'None'}")
