import pandas as pd
import matplotlib.pyplot as plt
import numpy as np

# Load data
df = pd.read_csv('table.csv')

# Clean column names (remove potential extra spaces)
df.columns = df.columns.str.strip()

# Function to extract numeric part before '('
def extract_number(cell):
    if pd.isna(cell):
        return np.nan
    cell = str(cell).strip()
    if '(' in cell:
        return float(cell.split('(')[0].replace(',', ''))
    else:
        return float(cell.replace(',', ''))

# Apply cleaning to all year columns (skip 'Ethnicity')
year_cols = df.columns[1:]
df_clean = df.copy()
for col in year_cols:
    df_clean[col] = df_clean[col].apply(extract_number)

# Remove 'All' row
df_clean = df_clean[df_clean['Ethnicity'] != 'All'].copy()

# Set Ethnicity as index for easier handling
df_plot = df_clean.set_index('Ethnicity')

# Normalize each year column to percentages
df_percent = df_plot.div(df_plot.sum(axis=0), axis=1) * 100

# Plot stacked bar chart
ax = df_percent.T.plot(kind='bar', stacked=True, figsize=(12, 8))
plt.title('Proportion of Different Ethnic Populations Over Time')
plt.xlabel('Year')
plt.ylabel('Percentage (%)')
plt.legend(title='Ethnicity', bbox_to_anchor=(1.05, 1), loc='upper left')
plt.xticks(rotation=45)
plt.tight_layout()
plt.show()
