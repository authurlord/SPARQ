df = pd.read_csv('table.csv')

# Select relevant columns
columns_to_check = ['eccentricity', 'inclination (deg) (to moon equator)', 'periselene (km)', 'aposelene (km)']

# Function to find outliers using IQR
def find_outliers(df, col):
    Q1 = df[col].quantile(0.25)
    Q3 = df[col].quantile(0.75)
    IQR = Q3 - Q1
    lower_bound = Q1 - 1.5 * IQR
    upper_bound = Q3 + 1.5 * IQR
    return df[(df[col] < lower_bound) | (df[col] > upper_bound)]

# Find outlier rows across all columns
outlier_rows = set()
for col in columns_to_check:
    outliers = find_outliers(df, col)
    outlier_rows.update(outliers.index)

# Extract the data points (rows) with outlier values
unusual_data_points = df.loc[list(outlier_rows)].copy()

# Print the unusual data points
print(unusual_data_points.to_string(index=False))
