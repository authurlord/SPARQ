import pandas as pd
import matplotlib.pyplot as plt
import re

df = pd.read_csv('table.csv')

# Function to clean cells: remove parentheses and extract only the number before them
def extract_number(cell):
    if pd.isna(cell):
        return 0
    # Remove commas and extract leading number before any parenthesis
    match = re.match(r'[\d,]+', str(cell))
    if match:
        return int(match.group().replace(',', ''))
    return 0

# Apply cleaning to all year columns (skip 'Ethnicity')
year_cols = df.columns[1:]
df_clean = df.copy()
for col in year_cols:
    df_clean[col] = df_clean[col].apply(extract_number)

# Exclude 'All' row
df_ethnic = df_clean[df_clean['Ethnicity'] != 'All'].copy()

# Set Ethnicity as index for easier plotting
df_ethnic.set_index('Ethnicity', inplace=True)

# Compute percentage for each year
df_pct = df_ethnic.div(df_ethnic.sum(axis=0), axis=1) * 100

# Plot stacked bar chart
ax = df_pct.T.plot(kind='bar', stacked=True, figsize=(12, 8))
plt.title('Proportion of Different Ethnic Populations Over Time (%)')
plt.xlabel('Year')
plt.ylabel('Percentage (%)')
plt.legend(title='Ethnicity', bbox_to_anchor=(1.05, 1), loc='upper left')
plt.xticks(rotation=45)
plt.tight_layout()
plt.show()
