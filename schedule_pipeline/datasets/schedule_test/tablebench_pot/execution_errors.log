import pandas as pd
import matplotlib.pyplot as plt
import re

# Load the data
df = pd.read_csv('table.csv')

# Clean the data: extract percentages from strings like '43,671 (31%)'
def extract_percentage(s):
    match = re.search(r'\(([^)]+)\)', s)
    if match:
        pct_str = match.group(1)
        return float(pct_str.rstrip('%')) / 100.0
    return 0.0

# Convert all rows to numeric percentages
years = ['1880', '1899', '1913', '19301', '1956', '1966', '1977', '1992', '2002']
ethnicities = df['Ethnicity'].tolist()

# Create a dictionary to store percentage values for each ethnicity per year
percent_data = {}
for ethnicity in ethnicities:
    row = df[df['Ethnicity'] == ethnicity].iloc[0]
    values = []
    for year in years:
        cell = row[year]
        if isinstance(cell, str):
            # Extract percentage from string like '43,671 (31%)'
            pct = extract_percentage(cell)
            values.append(pct)
        else:
            values.append(0.0)
    percent_data[ethnicity] = values

# Prepare data for plotting
years = [year.replace('19301', '1930') for year in years]  # Fix typo in '19301'
data = [percent_data[eth] for eth in ethnicities]

# Plot stacked bar chart
plt.figure(figsize=(14, 8))
x_pos = range(len(years))
bar_width = 0.2

for i, ethnicity in enumerate(ethnicities):
    y_values = data[i]
