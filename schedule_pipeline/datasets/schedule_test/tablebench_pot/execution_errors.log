def time_to_seconds(time_str):
    if pd.isna(time_str) or time_str == 'DNF' or time_str == 'DSQ':
        return None
    parts = time_str.split(':')
    minutes = int(parts[0])
    seconds = float(parts[1])
    return minutes * 60 + seconds

# Apply conversion to the 'Time' column
df['time_seconds'] = df['Time'].apply(time_to_seconds)

# Get the baseline time (first place, rank 1.0)
baseline_time = df.loc[df['Rank'] == '1.0', 'time_seconds'].iloc[0]

# Compute differences from baseline
df['diff_from_baseline'] = df['time_seconds'] - baseline_time

# Drop rows with NaN time or invalid data
df = df.dropna(subset=['diff_from_baseline'])

# Sort by rank for consistency
df = df.sort_values(by='Rank').reset_index(drop=True)

# Create waterfall chart
plt.figure(figsize=(12, 6))
plt.barh(df['Rank'], df['diff_from_baseline'], color='skyblue', edgecolor='black')
plt.axvline(x=0, color='red', linestyle='--', linewidth=2, label='Baseline')

# Labeling
plt.xlabel('Time Difference (seconds)')
plt.ylabel('Rank')
plt.title('Waterfall Chart of Completion Times Relative to First-Place Finisher')
