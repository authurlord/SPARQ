percent_russian = [(r / total) * 100 for r, total in zip(russian_students, total_values)]

# Calculate % learning in Latvian (already given)
percent_latvian = [float(row) for row in df['% learning in latvian']]

# Now, analyze trends: compute change in percentage over years
